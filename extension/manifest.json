{
  "manifest_version": 3,
  "name": "Browser Bridge",
  "version": "2.0.1",
  "minimum_chrome_version": "125",
  "description": "Connect DSH and Antigravity to your existing Microsoft Edge tabs through an authenticated local bridge.",
  "permissions": [
    "tabGroups",
    "debugger",
    "tabs",
    "activeTab",
    "storage",
    "alarms",
    "downloads"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Browser Bridge"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
